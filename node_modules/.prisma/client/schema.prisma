// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trade {
  id           String      @id @default(cuid())
  type         TradeType
  tokenAddress String
  tokenSymbol  String
  tokenName    String
  amount       Float
  price        Float
  totalValue   Float
  status       TradeStatus @default(PENDING)
  txHash       String?
  createdAt    DateTime    @default(now())
}

model Portfolio {
  id           String   @id @default(cuid())
  tokenAddress String   @unique
  tokenSymbol  String
  tokenName    String
  balance      Float
  avgBuyPrice  Float
  currentPrice Float
  pnl          Float    @default(0)
  lastUpdated  DateTime @updatedAt
}

model AIDecision {
  id              String      @id @default(cuid())
  tokenAddress    String
  tokenSymbol     String
  tokenName       String?
  logoUrl         String?
  action          TradeAction
  confidence      Float
  reasoning       String
  marketSentiment String
  riskLevel       RiskLevel
  priceTarget     Float?
  stopLoss        Float?
  createdAt       DateTime    @default(now())
}

model Memecoin {
  id             String   @id @default(cuid())
  address        String   @unique
  symbol         String
  name           String
  decimals       Int      @default(9)
  logoUrl        String?
  marketCap      Float?
  volume24h      Float?
  priceChange24h Float?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model AgentConfig {
  id                String        @id @default(cuid())
  riskTolerance     RiskTolerance @default(MEDIUM)
  maxPositionSize   Float         @default(10.0)
  stopLossPercent   Float         @default(5.0)
  takeProfitPercent Float         @default(20.0)
  tradingEnabled    Boolean       @default(true)
  autoTradeEnabled  Boolean       @default(false)
  updatedAt         DateTime      @updatedAt
}

enum TradeType {
  BUY
  SELL
}

enum TradeStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TradeAction {
  BUY
  SELL
  HOLD
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RiskTolerance {
  LOW
  MEDIUM
  HIGH
}
